# ─────────────────────────────────────────────────────────────────
# PRISM '26 Backend — Environment Configuration Template
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────
# PostgreSQL async connection string.
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/prism26

# ── JWT Secrets ───────────────────────────────────────────────────
# Generate strong random values, e.g.:
#   python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── JWT Expiry (optional — defaults shown) ────────────────────────
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Development default: React dev server on 5173.
CORS_ORIGINS=http://localhost:5173

# ── Development Seed Users ────────────────────────────────────────
# Passwords used by seed.py to create dev-only accounts.
# These accounts should NEVER exist in production.
SEED_ADMIN_PASSWORD=
SEED_ANCHOR_PASSWORD=
SEED_PARTICIPANT_PASSWORD=

# ── App Environment ───────────────────────────────────────────────
APP_ENV=development
